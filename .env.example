# ===== Base de datos =====
DB_NAME=bolsillo
DB_USER=bolsillo
DB_PASSWORD=cambia-esta-clave
DB_ROOT_PASSWORD=cambia-esta-clave-root

# ===== Backend =====
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=cambia-este-secreto
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# true cuando se accede por HTTPS (tailscale serve)
COOKIE_SECURE=true
DEFAULT_TIMEZONE=America/Bogota
DEFAULT_CURRENCY=COP
# Usuario inicial: se crea al arrancar solo si no existe ningún usuario
INITIAL_USER_EMAIL=tu@correo.com
INITIAL_USER_PASSWORD=cambia-esta-clave-larga

# ===== Notificaciones push (Web Push / VAPID) =====
# Genera las claves con: docker compose run --rm api python -m app.cli gen-vapid
# Sin claves la app funciona y los avisos quedan solo en la bandeja de la app.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@correo.com

# ===== Despliegue =====
# IP de Tailscale del servidor (tailscale ip -4). 127.0.0.1 si usas `tailscale serve`.
BIND_IP=127.0.0.1
WEB_PORT=8080
# Carpeta del host donde se guardan los backups (en el servidor: /data/bolsillo/backups)
BACKUP_DIR=./backups
# Días de backups a conservar
BACKUP_KEEP_DAYS=14
